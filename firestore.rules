rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'eveline.studiohair@gmail.com' ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public readable services, weeks, availability, blocked slots, and salon settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /weeks/{weekId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /availability/{dayId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blocked_slots/{blockId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Appointments: public read for slot availability & status check, clients can create with PENDENTE status, admin has full control
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if (
        request.resource.data.status == 'PENDENTE' &&
        request.resource.data.clientName is string &&
        request.resource.data.clientWhatsapp is string &&
        request.resource.data.serviceName is string &&
        request.resource.data.date is string &&
        request.resource.data.time is string
      ) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Clients directory: admin only
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    // Notifications: clients can create on booking, admin can read/manage
    match /notifications/{notificationId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    // Users / Admins: self read, admin write
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
