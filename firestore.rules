rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Salon settings & profile
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Hair and beauty services
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Weekly schedules and open/closed status
    match /weeks/{weekId} {
      allow read, write: if true;
    }

    // Availability rules and working hours per day
    match /availability/{dayId} {
      allow read, write: if true;
    }

    // Blocked slots and dates
    match /blocked_slots/{blockId} {
      allow read, write: if true;
    }

    // Appointments (Client requests, admin approvals, cancellations)
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Clients registry and history
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Notifications for admin and booking alerts
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Users and administration
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
